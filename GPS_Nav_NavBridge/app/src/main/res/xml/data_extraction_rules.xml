<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada de la app (claves WiFi, token, favoritas...) sale del móvil por copia de seguridad en la nube ni por
     transferencia entre dispositivos. Para cambiar de móvil se usa Ajustes > Exportar / Importar configuración. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
